{
  "name": "frontpaged-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "next build && npx --yes serve out",
    "package": "next build && cd out && zip -r -X ../frontpaged-site.zip . && cd ..",
    "lint": "eslint",
    "check:content": "node scripts/check-content.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:duplication": "node scripts/check-duplication.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:tracking": "node scripts/check-tracking.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "pnpm test && pnpm check:content && pnpm check:duplication && pnpm build && pnpm check:seo && pnpm check:links && pnpm check:tracking"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^18.0.5",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}

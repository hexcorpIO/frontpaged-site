# Exported content is derived from src/lib/* and content/blog/* by
# migration/export.mjs. Regenerating it is one command, and committing 1.5MB of
# duplicated post bodies would put every article in the repo twice — where the
# two copies would immediately start drifting.
migration/data/

# Secrets. This repository is public — the ACF Pro licence key must never be
# committed. It lives here and is read at install time only.
.env
*.zip

# SSH deploy keypair. The private half must never be committed —
# this repository is public.
secrets/
